 extends RigidBody3D
 ## Wooden ball: the first invitation. Visual only, no audio.
 
+const TRAIL_EVERY := 1.0
+const ROLL_BACK_SECONDS := 10
+
 var _cooldown := 0.0
+## Where the ball was, once a second, newest last.
+var _trail: Array[Vector3] = []
